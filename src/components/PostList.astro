---
import type { ListItem } from '../lib/posts';

interface Props {
  items: ListItem[];
}
const { items } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<ul class="post-list">
  {items.map((p) => (
    <li data-tag={p.tag}>
      <time class="muted" datetime={p.date.toISOString()}>{fmt(p.date)}</time>
      <span class="title">
        <a href={p.href} {...(p.source ? { target: '_blank', rel: 'noopener' } : {})}>{p.title}</a>
        {p.source && <span class="source muted">↗ {p.source}</span>}
      </span>
      <span class={`tag tag-${p.tag}`}>{p.tag.replaceAll('-', ' ')}</span>
    </li>
  ))}
</ul>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0;
  }
  .post-list li[hidden] { display: none; }
  .post-list a { text-decoration-color: transparent; font-weight: 500; }
  .post-list a:hover { text-decoration-color: var(--petal); }
  .source { font-size: 0.8rem; margin-left: 0.35rem; white-space: nowrap; }
  time { font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  @media (max-width: 34rem) {
    .post-list li { grid-template-columns: 1fr auto; row-gap: 0; }
    .post-list time { grid-column: 1 / -1; }
  }
</style>

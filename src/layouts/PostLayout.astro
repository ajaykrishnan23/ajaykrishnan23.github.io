---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  summary?: string;
  date: Date;
  tag: 'technical' | 'not-so-technical';
  minutes: number;
}
const { title, description, summary, date, tag, minutes } = Astro.props;
const pretty = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={description}>
  <article class="post">
    <header class="post-head">
      <h1>{title}</h1>
      {summary && <p class="summary">{summary}</p>}
      <p class="meta muted">
        <time datetime={date.toISOString()}>{pretty}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        <span class={`tag tag-${tag}`}>{tag.replaceAll('-', ' ')}</span>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <p class="back"><a href="/blog">← back to the garden</a></p>
  </article>
</BaseLayout>

<style>
  .post-head { margin-bottom: 2.25rem; }
  .summary {
    font-family: var(--font-head);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin: 0.25rem 0 0.9rem;
  }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.92rem; margin: 0; }
  .prose :global(figure) { margin-block: 2rem; margin-inline: 0; }
  .prose :global(figure.wide) { margin-left: 50%; }
  .prose :global(figcaption) { font-size: 0.88rem; color: var(--ink-soft); text-align: center; margin-top: 0.5rem; }
  .back { margin-top: 3.5rem; }
</style>
